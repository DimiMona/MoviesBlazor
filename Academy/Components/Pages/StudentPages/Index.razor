@page "/students"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@using Academy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory

<PageTitle>Студенты</PageTitle>

	<h1>Студенты</h1>

<div class="controls">
	<p>
		<a href="students/create" class="btn btn-primary">Добавить</a>
	</p>
	<form action="/students">
		<input type="search" name="Filter" />
		<input type="submit" value="Найти Группу" />
	</form>
	<div>
		<label for="items-per-page">"Элементов на странице:"</label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="10">10</option>
		</select>
	</div>
</div>

@* <QuickGrid Class="table" Items="context.Students.Include(s => s.Group).ThenInclude(g => g.Direction)"> *@
<QuickGrid Class="table" Items="FilteredStudents" Pagination="@pagination">
	@* <PropertyColumn Property="student => student.last_name" />
	<PropertyColumn Property="student => student.first_name" />
	<PropertyColumn Property="student => student.middle_name" /> *@
	<TemplateColumn Context="student"
					Title="Student"
					Sortable="true"
					SortBy="sortBy"
					>
		<a href="@($"students/details?stud_id={student.stud_id}")">@student.FullName</a>
	</TemplateColumn>
	@* <PropertyColumn Property="student => student.FullName" Sortable="true" /> *@
	<PropertyColumn Property="student => student.birth_date" Sortable="true" />
	<TemplateColumn Context="student"
					Title="Age"
					Sortable="true"
					SortBy="GridSort<Student>.ByDescending(s => s.birth_date)"
					>
					@student.Age
	</TemplateColumn>
	<PropertyColumn Property="student => student.Group.group_name" Sortable="true" />
	<PropertyColumn Property="student => student.Group.Direction.direction_name" Sortable="true" />
	@* <PropertyColumn Property="student => student.email" />
	<PropertyColumn Property="student => student.phone" />
	<PropertyColumn Property="student => student.photo" /> *@

	@* <TemplateColumn Context="student">
		<a href="@($"students/edit?stud_id={student.stud_id}")">Edit</a> |
		<a href="@($"students/details?stud_id={student.stud_id}")">Details</a> |
		<a href="@($"students/delete?stud_id={student.stud_id}")">Delete</a>
	</TemplateColumn> *@
</QuickGrid>
<Paginator State="pagination" />
@code
{
	private AcademyContext context = default!;
	IQueryable<Student> students = default!;
	GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name)
												//.ThenAscending(s => s.first_name)
												//ASC  - Ascending	(в порядке возрастания)
												//DESC - Descending (в порядке убывания)
												;

	[SupplyParameterFromQuery]
	string? Filter { get;set;}
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };
	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
		students = context.Students.Include(s => s.Group);
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();

	IQueryable<Academy.Models.Student> FilteredStudents =>
	context.Students
			.Include(s => s.Group)
			.ThenInclude(g => g.Direction)
			.AsEnumerable()
			.Where(s =>
			string.IsNullOrWhiteSpace(Filter) ||
			s.FullName.Contains(Filter) ||
			(s.Group != null && s.Group.group_name.Contains(Filter)) ||
			(s.Group != null && s.Group.Direction != null && s.Group.Direction.direction_name.Contains(Filter)))
			.AsQueryable();


	
}
