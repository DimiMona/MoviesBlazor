@page "/groups"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@using Academy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory

<PageTitle>Groups</PageTitle>

    <h1>Группы</h1>

<div class="controls">

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>

    <form action="/groups">
        <input type="search" name="titleFilter" />
        <input type="submit" value="Найти Группу" />
    </form>

    <div>
        <label for="items-per-page">"Элементов на странице:"</label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="10">10</option>
        </select>
    </div>
</div>

<QuickGrid Class="table" Items="FilteredGroups" Pagination="@pagination">
    <PropertyColumn Property="group => group.group_name" Title="Название группы" />
    <PropertyColumn Property="group => group.Direction.direction_name" />
    <PropertyColumn Property="group => group.start_date" />
    <PropertyColumn Property="group => group.start_time" />
    <PropertyColumn Property="group => new Week((int)(group.learning_days ?? 0))" />
    @* <PropertyColumn Property="group => group.learning_days" /> *@

    <TemplateColumn Context="group">
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a>
    </TemplateColumn>
</QuickGrid>
<Paginator State="pagination"/>
@code {
    private AcademyContext context = default!;
    [SupplyParameterFromQuery]
    string? TitleFilter { get; set; }
    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    IQueryable<Group> FilteredGroups
    {
        get
        {
            var query = context.Groups.Include(g => g.Direction);

            if (string.IsNullOrWhiteSpace(TitleFilter))
                return query;

            var f = TitleFilter.Trim();
            return query.Where(g =>
                g.group_name.Contains(f) ||
                g.Direction.direction_name.Contains(f)
            // добавьте сюда другие поля
            );
        }
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
    
}
