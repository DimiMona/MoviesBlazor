@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Group</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Group" OnValidSubmit="AddGroup" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label> 
                <InputText id="name" @bind-Value="Group.Name" class="form-control" /> 
                <ValidationMessage For="() => Group.Name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="direction" class="form-label">direction:</label> 
                <InputNumber id="direction" @bind-Value="Group.direction" class="form-control" /> 
                <ValidationMessage For="() => Group.direction" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="startdate" class="form-label">StartDate:</label> 
                <InputDate id="startdate" @bind-Value="Group.StartDate" class="form-control" /> 
                <ValidationMessage For="() => Group.StartDate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="starttime" class="form-label">StartTime:</label> 
                <InputDate id="starttime" @bind-Value="Group.StartTime" class="form-control" /> 
                <ValidationMessage For="() => Group.StartTime" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="learningdays" class="form-label">LearningDays:</label> 
                <InputNumber id="learningdays" @bind-Value="Group.LearningDays" class="form-control" /> 
                <ValidationMessage For="() => Group.LearningDays" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/groups">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Group Group { get; set; } = default!;

    protected override void OnInitialized() => Group ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Group.Add(Group);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}
