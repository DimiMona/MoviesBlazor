@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Discipline</h2>
    <hr />
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@discipline.Name</dd>
            <dt class="col-sm-2">number</dt>
            <dd class="col-sm-10">@discipline.number</dd>
        </dl>
        <div>
            <a href="@($"/disciplines/edit?id={discipline.Id}")">Edit</a> |
            <a href="@($"/disciplines")">Back to List</a>
        </div>
    }
</div>

@code {
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Discipline.FirstOrDefaultAsync(m => m.Id == Id);

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
