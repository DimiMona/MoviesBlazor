@page "/directions"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="directions/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Directions">
    <PropertyColumn Property="direction => direction.Name" />

    <TemplateColumn Context="direction">
        <a href="@($"directions/edit?id={direction.Id}")">Edit</a> |
        <a href="@($"directions/details?id={direction.Id}")">Details</a> |
        <a href="@($"directions/delete?id={direction.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private MyAcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
